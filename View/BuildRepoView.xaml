<UserControl x:Class="CommandCenter.View.BuildRepoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CommandCenter.ViewModel"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <!-- Same orange "needs sign-in" treatment as the Maintenance Verification tab -->
        <Style x:Key="SignInButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsSignIn}" Value="True">
                    <Setter Property="Background" Value="#FFFF8C00"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Round floating-action-style (+) toggle: shows "+" collapsed, "−" expanded -->
        <Style x:Key="FabToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Show / hide contents"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#FF3D85C6">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="Sign" Text="+" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sign" Property="Text" Value="−"/>
                                <Setter TargetName="Circle" Property="Fill" Value="#FF1F5F99"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#FF5A9BD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree rows: FAB toggle (folders only - hidden but space-holding for files) + glyph + name -->
        <Style x:Key="RepoTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Padding="4,3" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="True">
                                <DockPanel>
                                    <ToggleButton x:Name="Fab" DockPanel.Dock="Left" Style="{StaticResource FabToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="26,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                                <Setter TargetName="Fab" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMessage}" Value="True">
                                <Setter TargetName="Fab" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFCCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- placeholder rows ("Loading...", "(empty)", errors) can't be selected -->
                <DataTrigger Binding="{Binding IsMessage}" Value="True">
                    <Setter Property="Focusable" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Auto-fit: the grid fills the visible area (Height = viewport), but never shrinks below what
         every element needs (MinHeight, kept up to date in code-behind). On first show the window
         grows to fit that; if the screen is too small for it, this scrolls instead of clipping. -->
    <ScrollViewer x:Name="RootScroll" Padding="12" Focusable="False"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="RootGrid" Height="{Binding ViewportHeight, ElementName=RootScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Sign in to Google" Command="{Binding SignInCommand}" Style="{StaticResource SignInButton}"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Build Repo" FontSize="16" FontWeight="Bold"/>
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="Click (+) on a version to see its builds, and (+) on a build to see what's inside. Select a build, folder or file to download it - or tick several Full/Partial folders in one build to batch them (Full is applied first)."/>
            </StackPanel>
        </DockPanel>

        <!-- Repo tree: MapleStory (GMS) > version > builds (from each version's Build folder) > contents -->
        <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4">
            <TreeView ItemsSource="{Binding RootNodes}"
                      ItemContainerStyle="{StaticResource RepoTreeItem}"
                      BorderThickness="0" Padding="4">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:BuildRepoNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Full/Partial folders only: tick several from the same build to download + apply them together, in order -->
                            <CheckBox IsChecked="{Binding IsBatchChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Focusable="False"
                                      ToolTip="Add to batch - tick several Full/Partial folders from the same build to download and apply them in order (Full first)"
                                      IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                      Visibility="{Binding IsBatchEligible, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF3D85C6"/>
                            <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SizeText}" Margin="10,0,0,0" Foreground="#FF666666" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="  loading..." Opacity="0.6" FontStyle="Italic" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Root">
                                <Setter TargetName="NameText" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="NameText" Property="FontSize" Value="14"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Version">
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Build">
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FF1E7B34"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="File">
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FF666666"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Message">
                                <Setter TargetName="NameText" Property="FontStyle" Value="Italic"/>
                                <Setter TargetName="NameText" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Download panel -->
        <Border x:Name="DownloadPanel" Grid.Row="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8"
                SizeChanged="DownloadPanel_SizeChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected:" FontWeight="SemiBold" Margin="0,0,10,6" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Clear Batch" Command="{Binding ClearBatchCommand}" Padding="10,3" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Download for tab:" FontWeight="SemiBold" Margin="0,0,10,6" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Open Build Folder" Command="{Binding OpenBuildFolderCommand}" Padding="10,3" Margin="8,0,0,0"/>
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                              DisplayMemberPath="Title" MinWidth="220" HorizontalAlignment="Left"
                              IsEnabled="{Binding IsNotBusy}"/>
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Build directory:" FontWeight="SemiBold" Margin="0,0,10,6" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetBuildPathText}" TextWrapping="Wrap" Margin="0,0,0,6" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TargetHasNoBuildPath}" Value="True">
                                    <Setter Property="Foreground" Value="#FFB3261E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="After download:" FontWeight="SemiBold" Margin="0,2,10,8" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2,0,8">
                    <!-- The two are exclusive (checking one unchecks the other in the view model); neither = plain download. -->
                    <CheckBox IsChecked="{Binding ExtractAfterDownload, Mode=TwoWay}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,6">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="New Build" FontWeight="SemiBold"/>
                            <Run Text=" - Downloads the files, extracts them, then applies Full_*.zip exactly like the New Build button (the current build is DELETED and replaced). Anything else (Partial Client folders / Partial_*.zip) is then applied on top like Patch." Foreground="#FF666666"/>
                        </TextBlock>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding PatchAfterDownload, Mode=TwoWay}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,6">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Patch" FontWeight="SemiBold"/>
                            <Run Text=" - Downloads the files, extracts them, then applies everything (Full_*.zip included) exactly like the Patch button: the current build is KEPT and new files are copied over it, overwriting only files with the same name. Partial Client folders are merged in order, nested archives unpacked, AdminClient/Bin flattened." Foreground="#FF666666"/>
                        </TextBlock>
                    </CheckBox>
                    <TextBlock Text="Neither checked = just download the files into the Current Build directory, no extraction." Foreground="#FF666666" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>

                <DockPanel Grid.Row="4" Grid.ColumnSpan="2">
                    <Button DockPanel.Dock="Left" Content="{Binding DownloadButtonText}" Command="{Binding DownloadCommand}"
                            Padding="14,5" MinWidth="150" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" Padding="12,5" Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button DockPanel.Dock="Right" Content="Resume" Command="{Binding ResumeCommand}" Padding="12,5" Margin="8,0,0,0"
                            FontWeight="SemiBold" ToolTip="Continue the interrupted download from where it stopped"
                            Visibility="{Binding IsAwaitingResume, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <ProgressBar Height="14" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.85"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Log -->
        <TextBox Grid.Row="3" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 TextChanged="Log_TextChanged"/>
    </Grid>
    </ScrollViewer>
</UserControl>
