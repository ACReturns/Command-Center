<UserControl x:Class="CommandCenter.View.ServerStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="560">
    <UserControl.Resources>
        <DataTemplate x:Key="WorldTemplate">
            <Border Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,8" Width="150">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="32" Height="32" gif:ImageBehavior.AnimatedSource="{Binding StatusGifPath}"
                           Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,8">
                <StackPanel Margin="12,8,0,8">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Width="80" Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="Checking..." VerticalAlignment="Center" Foreground="#FF666666" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Worlds}" ItemTemplate="{StaticResource WorldTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Server Status" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh All" Margin="16,0,0,0" Padding="8,4" Command="{Binding RefreshAllCommand}"/>
            <Button Content="Close" Margin="8,0,0,0" Padding="8,4" Command="{Binding CloseCommand}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
