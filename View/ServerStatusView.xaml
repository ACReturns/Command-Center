<UserControl x:Class="CommandCenter.View.ServerStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="560">
    <UserControl.Resources>
        <DataTemplate x:Key="WorldTemplate">
            <Border Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,8" Width="150">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="32" Height="32" gif:ImageBehavior.AnimatedSource="{Binding StatusGifPath}"
                           Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <Border Background="#FFEFF2F7" BorderBrush="#FFD7DCE3" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            <!-- Rename/Delete: only ever shown for a group added via "Add New Server" -
                                 the 3 built-in groups (Live/Staging/Test) have IsCustom = false. -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                <Button Content="Rename" Padding="6,2" FontSize="11"
                                        Command="{Binding DataContext.RenameServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Delete" Padding="6,2" Margin="6,0,0,0" FontSize="11"
                                        Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="12,8,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Refresh" Width="80" Command="{Binding RefreshCommand}"/>
                            <TextBlock Text="Checking..." VerticalAlignment="Center" Foreground="#FF666666" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Worlds}" ItemTemplate="{StaticResource WorldTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Server Status" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh All" Margin="16,0,0,0" Padding="8,4" Command="{Binding RefreshAllCommand}"/>
            <Button Content="Add New Server" Margin="8,0,0,0" Padding="8,4" Command="{Binding AddServerCommand}"/>
            <Button Content="Close" Margin="8,0,0,0" Padding="8,4" Command="{Binding CloseCommand}"/>
        </StackPanel>

        <!-- Legend: lets a new user tell at a glance which icon means a server is up vs. down. -->
        <Border Grid.Row="1" Background="#FFEFF2F7" BorderBrush="#FFD7DCE3" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Image Width="20" Height="20" gif:ImageBehavior.AnimatedSource="{Binding ServerUpGifPath}"/>
                <TextBlock Text="Server Up" VerticalAlignment="Center" Margin="6,0,20,0"/>
                <Image Width="20" Height="20" gif:ImageBehavior.AnimatedSource="{Binding ServerDownGifPath}"/>
                <TextBlock Text="Server Down" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
