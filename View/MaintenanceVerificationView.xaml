<UserControl x:Class="CommandCenter.View.MaintenanceVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <!-- Sign-in button turns orange when Google needs a sign-in -->
        <Style x:Key="SignInButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsSignIn}" Value="True">
                    <Setter Property="Background" Value="#FFFF8C00"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Solid bottom-border divider between rows (used instead of DataGrid's native hairline
             GridLinesVisibility, which is a 1-device-pixel Pen that can thin out to nothing when the
             grid is rendered at a smaller scale) -->
        <Style x:Key="RowDivider" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#FFC9C9C9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="SummaryBanner" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SummaryState}" Value="None">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SummaryState}" Value="Pass">
                    <Setter Property="Background" Value="#FFDFF3E3"/>
                    <Setter Property="TextElement.Foreground" Value="#FF1E7B34"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SummaryState}" Value="Fail">
                    <Setter Property="Background" Value="#FFFDE2E2"/>
                    <Setter Property="TextElement.Foreground" Value="#FFB3261E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SummaryState}" Value="Cancelled">
                    <Setter Property="Background" Value="#FFFFF1D6"/>
                    <Setter Property="TextElement.Foreground" Value="#FF8A5A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Newest release on top" IsChecked="{Binding NewestFirst, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Sign in to Google" Command="{Binding SignInCommand}" Style="{StaticResource SignInButton}"/>
                <Button Content="Refresh Sheet" Command="{Binding RefreshSheetCommand}" Style="{StaticResource ToolbarButton}"/>
                <Button Content="Open Checksums Folder" Command="{Binding OpenChecksumsFolderCommand}" Style="{StaticResource ToolbarButton}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Maintenance Version Verification" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding SheetStatusText}" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Version sheet -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding RowsView}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowStyle="{StaticResource RowDivider}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  CanUserSortColumns="False">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#FF3D85C6" Padding="6,3">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Release Version" Binding="{Binding Version}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="Internal Upload Tag" Binding="{Binding Tag}" Width="*"/>
                <DataGridTextColumn Header="Checksum (.md5)" Binding="{Binding ChecksumStatus}" Width="Auto" MinWidth="170"/>
                <DataGridTextColumn Header="Installed On" Binding="{Binding InstalledOn}" Width="Auto" MinWidth="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Verify panel -->
        <Border Grid.Row="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Installed build:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Grid.Row="0" Grid.Column="1">
                    <ComboBox ItemsSource="{Binding InstalledBuilds}"
                              SelectedItem="{Binding SelectedBuild, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              IsEnabled="{Binding HasInstalledBuilds}"
                              MaxWidth="480" HorizontalAlignment="Left" MinWidth="280"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Checksum:" VerticalAlignment="Center" Margin="0,6,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRowDisplay}" VerticalAlignment="Center"
                           Margin="0,6,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadChecksumCommand}" Padding="12,4" MinWidth="130"/>
                    <Button Content="Run Verification" Command="{Binding VerifyCommand}" Padding="12,4" Margin="6,0,0,0" MinWidth="130" FontWeight="SemiBold"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,4" Margin="6,0,0,0" MinWidth="80"/>
                </StackPanel>

                <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <ProgressBar DockPanel.Dock="Left" Width="220" Height="14"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <DockPanel Grid.Row="3">
            <Border DockPanel.Dock="Top" Style="{StaticResource SummaryBanner}">
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <TabControl>
                <TabItem Header="{Binding ResultsHeader}">
                    <DataGrid ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource RowDivider}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcome}" Value="Mismatch">
                                        <Setter Property="Background" Value="#FFFDE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="Missing">
                                        <Setter Property="Background" Value="#FFFFF1D6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="Error">
                                        <Setter Property="Background" Value="#FFEDE4F7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/>
                            <DataGridTextColumn Header="Expected MD5" Binding="{Binding ExpectedHash}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="Auto" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{Binding ExtrasHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="4,4,4,6" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Files in the build folder that the .md5 doesn't list. Informational only - these never fail a verification."/>
                        <ListBox ItemsSource="{Binding Extras}" FontFamily="Consolas"
                                 VirtualizingPanel.IsVirtualizing="True"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Raw Log">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
