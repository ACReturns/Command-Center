<UserControl x:Class="CommandCenter.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="740">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFF3F3F3"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Tabs" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,12">
                <Run Text="Reorder (&#x25B2;&#x25BC;), rename, hide, or delete tabs below, then click Save Settings."/>
                <Run Text=" Nothing here takes effect until you save - and switching away from this tab with unsaved changes will ask first."/>
            </TextBlock>

            <ItemsControl x:Name="TabsList" ItemsSource="{Binding DraftTabs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <!-- Marked-for-deletion: compact row + Restore, editable fields hidden -->
                                <DockPanel Visibility="{Binding IsMarkedForDeletion, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Restore" DockPanel.Dock="Right" Width="80" Padding="4,2" Command="{Binding RestoreCommand}"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF999999" TextDecorations="Strikethrough"/>
                                        <Run Text=" will be deleted on save" Foreground="#FFB00000"/>
                                    </TextBlock>
                                </DockPanel>

                                <!-- Normal editable row -->
                                <StackPanel Visibility="{Binding IsMarkedForDeletion, Converter={StaticResource InverseBoolToVis}}">
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="&#x25B2;" Width="26" Padding="0" Margin="0,0,4,0" ToolTip="Move up"
                                                    Command="{Binding DataContext.MoveTabUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#x25BC;" Width="26" Padding="0" Margin="0,0,10,0" ToolTip="Move down"
                                                    Command="{Binding DataContext.MoveTabDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Width="70" Padding="4,2" Background="#FFFDECEA"
                                                    Visibility="{Binding IsPermanent, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                        <CheckBox Content="Visible" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsVisible}" IsEnabled="{Binding CanHide}"
                                                  ToolTip="Settings can't be hidden - it's the only way back into this screen."/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>

                                    <StackPanel Visibility="{Binding IsBuildSection, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button Content="Browse..." DockPanel.Dock="Right" Width="90" Command="{Binding BrowseCommand}"/>
                                            <TextBox Text="{Binding BuildPath}" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Version Number:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding VersionNumber, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                        </StackPanel>

                                        <!-- Available Servers: this tab's own launch dropdown - built-in entries (seeded
                                             from LaunchServerCatalog, connect/disconnect only) and custom ones (added via
                                             "+ Add Custom Server" below, freely editable/removable) side by side. See
                                             DraftServerViewModel/TabServerEntry. Collapsed by default once a tab already
                                             has servers configured (see DraftTabViewModel.IsServersExpanded) - expanding/
                                             collapsing is just view state, not an unsaved change. -->
                                        <Expander IsExpanded="{Binding IsServersExpanded, Mode=TwoWay}" Margin="0,0,0,0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Available Servers" FontWeight="SemiBold"/>
                                                    <TextBlock Foreground="#FF888888" Margin="6,0,0,0">
                                                        <Run Text="("/>
                                                        <Run Text="{Binding Servers.Count, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Expander.Header>

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" Foreground="#FF666666" FontSize="11" Margin="0,0,0,6">
                                                    <Run Text="Shown here is what this tab's Launch dropdown can offer. Connect/disconnect a built-in server with its checkbox;"/>
                                                    <Run Text=" add your own below for anything not in the built-in list."/>
                                                </TextBlock>

                                                <ItemsControl ItemsSource="{Binding Servers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="0,6">
                                                            <Grid>
                                                                <!-- Marked-for-deletion: compact row + Restore (custom servers only) -->
                                                                <DockPanel Visibility="{Binding IsMarkedForDeletion, Converter={StaticResource BoolToVis}}">
                                                                    <Button Content="Restore" DockPanel.Dock="Right" Width="70" Padding="4,2" Command="{Binding RestoreCommand}"/>
                                                                    <TextBlock VerticalAlignment="Center">
                                                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF999999" TextDecorations="Strikethrough"/>
                                                                        <Run Text=" will be removed on save" Foreground="#FFB00000"/>
                                                                    </TextBlock>
                                                                </DockPanel>

                                                                <!-- Normal row -->
                                                                <DockPanel Visibility="{Binding IsMarkedForDeletion, Converter={StaticResource InverseBoolToVis}}">
                                                                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,3,10,0"
                                                                              IsChecked="{Binding IsEnabled}"
                                                                              ToolTip="Connected - included in this tab's Launch dropdown"/>
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBoolToVis}}">
                                                                        <Button Content="Edit" Width="50" Padding="0,2" Margin="0,0,4,0" Command="{Binding EditCommand}"/>
                                                                        <Button Content="Remove" Width="64" Padding="0,2" Background="#FFFDECEA" Command="{Binding DeleteCommand}"/>
                                                                    </StackPanel>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                            <!-- Run has no Visibility property (it's not a UIElement) - a separate TextBlock is
                                                                                 needed so this tag can be hidden for a custom entry. -->
                                                                            <TextBlock Text=" (Built-in)" Foreground="#FF999999" FontStyle="Italic" Margin="4,0,0,0"
                                                                                       Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding LaunchArgumentPreview, Mode=OneWay}" FontSize="11" Foreground="#FF888888"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="+ Add Custom Server" Width="150" Padding="6,4" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="{Binding AddCustomServerCommand}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No more GMS/CMS/Live picker - extras are independent top-level tabs now, not
                 nested under a parent category, so there's nothing to choose here. One click adds
                 a plain build-section row below with Title/BuildPath/VersionNumber ready to fill
                 in (see SettingsViewModel.AddTab). -->
            <Button Content="+ Add Tab" Width="120" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Command="{Binding AddTabCommand}"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Save Settings" Width="140" Padding="8,4" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FF2E7D32"/>
                <TextBlock Text="Unsaved changes" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFB00000" FontWeight="SemiBold"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
