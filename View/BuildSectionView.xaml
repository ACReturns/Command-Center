<UserControl x:Class="CommandCenter.View.BuildSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="620">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: current build path + version, at a glance -->
        <Border Grid.Row="0" Background="#FFF3F3F3" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="{Binding SectionTitle, Mode=OneWay}"/>
                    <Run Text=" Current Build:"/>
                </TextBlock>
                <TextBlock Text="{Binding CurrentBuildPath, Mode=OneWay, TargetNullValue='Not set'}" Margin="6,0,24,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentBuildPath}" MaxWidth="340"/>
                <TextBlock Text="Version:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VersionNumber, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mode selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding IsNotBusy}">
            <RadioButton Content="New Build" Margin="0,0,16,0" IsChecked="{Binding IsNewBuild}" VerticalAlignment="Center"/>
            <RadioButton Content="Patch" Margin="0,0,16,0" IsChecked="{Binding IsPatch}" VerticalAlignment="Center"/>
            <RadioButton Content="Pushed to Live" Margin="0,0,16,0" IsChecked="{Binding IsPushedToLive}" VerticalAlignment="Center"
                         Visibility="{Binding SupportsPushedToLive, Converter={StaticResource BoolToVis}}"/>
            <RadioButton Content="Launch" IsChecked="{Binding IsLaunch}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- New Build / Patch panel -->
            <StackPanel Visibility="{Binding IsUpdatePanelVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Not configured. Set this section's build path in the Settings tab first." Foreground="#FFB00000" Margin="0,0,0,8"
                           Visibility="{Binding HasBuildPath, Converter={StaticResource InverseBoolToVis}}"/>

                <TextBlock Text="Build / Patch Archive (.zip, .7z)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Browse..." DockPanel.Dock="Right" Width="90" Command="{Binding BrowseSourceCommand}"/>
                    <TextBox Text="{Binding SourceArchivePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="Set Version Number To (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PendingVersion, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                <Button Content="{Binding RunButtonLabel}" Width="160" HorizontalAlignment="Left" Padding="8,4" Command="{Binding RunUpdateCommand}"/>
            </StackPanel>

            <!-- Pushed to Live panel: only reachable on Live Service sections (see the radio button's
                 SupportsPushedToLive-bound visibility). Moves a source's entire contents into this
                 section's Current Build folder instead of extracting an archive. The source is
                 either another build-section tab (GMS/CMS/any extra - PushTargets, showing each
                 tab's name and current Version Number) or a manually browsed folder ("Folder to
                 Push to Live", the original behavior) - every RadioButton below shares GroupName
                 "PushSource" so picking one always unchecks the rest. -->
            <StackPanel Visibility="{Binding IsPushedToLivePanelVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Not configured. Set this section's build path in the Settings tab first." Foreground="#FFB00000" Margin="0,0,0,8"
                           Visibility="{Binding HasBuildPath, Converter={StaticResource InverseBoolToVis}}"/>

                <TextBlock Text="Push Source" FontWeight="SemiBold" Margin="0,0,0,4"/>

                <!-- One radio per other build-section tab - name + Version Number together, e.g.
                     "GMS (271.0.3)", per PushTargetOption.DisplayName. -->
                <ItemsControl ItemsSource="{Binding PushTargets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding DisplayName}" GroupName="PushSource" IsChecked="{Binding IsSelected}" Margin="0,0,0,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <RadioButton Content="Folder to Push to Live" GroupName="PushSource" IsChecked="{Binding IsCustomFolderSelected}" Margin="0,0,0,8"/>

                <!-- Only shown/used for "Folder to Push to Live" - picking an existing tab above
                     uses that tab's own Current Build folder instead. -->
                <DockPanel Margin="0,0,0,8" Visibility="{Binding IsCustomFolderSelected, Converter={StaticResource BoolToVis}}">
                    <Button Content="Browse..." DockPanel.Dock="Right" Width="90" Command="{Binding BrowsePushSourceCommand}"/>
                    <TextBox Text="{Binding PushSourceFolderPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="This clears the Current Build folder above first, then moves everything from the selected source into it. This can't be undone."
                           Foreground="#FFB00000" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Folder to Push to Live: version number is free text, since it varies and isn't
                     known ahead of time. -->
                <StackPanel Visibility="{Binding IsCustomFolderSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Set Version Number To (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PendingVersion, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Existing tab picked instead: the Version Number comes from that tab, not typed
                     in here - shown read-only so it's clear what will land on Live. -->
                <StackPanel Visibility="{Binding IsCustomFolderSelected, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Version Number Will Be Set To" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedPushTarget.VersionDisplay}"/>
                </StackPanel>

                <Button Content="Push to Live" Width="160" HorizontalAlignment="Left" Padding="8,4" Command="{Binding PushToLiveCommand}"/>
            </StackPanel>

            <!-- Launch panel: this tab's own enabled executables (from Settings' "Available
                 Executables") + this section's own server list -->
            <StackPanel Visibility="{Binding IsLaunchPanelVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="#FFB00000" Margin="0,0,0,8" Visibility="{Binding IsSelectedExecutableMissing, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding SelectedExecutable, Mode=OneWay}"/>
                    <Run Text=" was not found in the build folder."/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Executable" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ExecutableOptions}" SelectedItem="{Binding SelectedExecutable}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Select Server" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ServerOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedServerOption}"/>
                    </StackPanel>
                </Grid>

                <Button Content="Launch Build" Width="160" HorizontalAlignment="Left" Padding="8,4" Margin="0,12,0,0" Command="{Binding LaunchCommand}"/>

                <!-- Debug command list: toggling this on shows an Add/Edit/Delete editor for this
                     tab's saved cmd_uidebug.txt (see Services/DebugCommandListService). The
                     entries themselves are saved under AppData regardless of this checkbox - it
                     only controls whether this editor is shown and whether Launch Build copies
                     the file into the build folder (see BuildSectionViewModel.Launch). -->
                <CheckBox Content="Enable Debug Command List" IsChecked="{Binding DebugCommandListEnabled}" Margin="0,16,0,0"/>

                <StackPanel Visibility="{Binding DebugCommandListEnabled, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="Debug Commands" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="Saved here, then copied into the build folder as cmd_uidebug.txt right before Launch Build runs."
                               Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <Border MinHeight="60" MaxHeight="140" Background="White" BorderBrush="#FFB0B0B0" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="No debug commands yet. Use Add below."
                                       TextWrapping="Wrap" Foreground="#FF888888" Margin="10" VerticalAlignment="Center"
                                       Visibility="{Binding HasDebugCommands, Converter={StaticResource InverseBoolToVis}}"/>
                            <ListBox x:Name="DebugCommandsListBox" ItemsSource="{Binding DebugCommands}" BorderThickness="0" MaxHeight="140"
                                     Visibility="{Binding HasDebugCommands, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add..." Width="80" Padding="6,3" Command="{Binding AddDebugCommandCommand}"/>
                        <!-- Carries an existing debug command list (an old cmd_uidebug.txt, or
                             any plain text file with one command per line) straight into this
                             tab's saved list instead of retyping every line via Add. -->
                        <Button Content="Import..." Width="80" Padding="6,3" Margin="8,0,0,0" Command="{Binding ImportDebugCommandsCommand}"/>
                        <Button Content="Edit..." Width="80" Padding="6,3" Margin="8,0,0,0"
                                Command="{Binding EditDebugCommandCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DebugCommandsListBox}"/>
                        <Button Content="Delete" Width="80" Padding="6,3" Margin="8,0,0,0"
                                Command="{Binding DeleteDebugCommandCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DebugCommandsListBox}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Documents: always visible regardless of the mode selected above - attached to
             whichever build this section currently points at (see DocumentsService /
             BuildSectionViewModel.SyncDocumentsFolder). Files can be dropped straight from
             Explorer onto the box below, or added via the button; double-click an entry to open
             it. Auto-refreshes on any external change to the folder via a FileSystemWatcher. -->
        <Border Grid.Row="3" Background="#FFF3F3F3" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding DocumentsFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                <TextBlock Text="Not configured. Set this section's build path in the Settings tab first." Foreground="#FFB00000" Margin="0,0,0,4"
                           Visibility="{Binding HasBuildPath, Converter={StaticResource InverseBoolToVis}}"/>

                <StackPanel Visibility="{Binding HasBuildPath, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="DocumentsDropZone" MinHeight="70" MaxHeight="160" Background="White" BorderBrush="#FFB0B0B0" BorderThickness="1"
                            AllowDrop="True" DragEnter="DocumentsDropZone_DragEnter" DragOver="DocumentsDropZone_DragEnter" Drop="DocumentsDropZone_Drop">
                        <Grid>
                            <TextBlock Text="No current documents for this build. Drag &amp; drop files here, or use Add File below."
                                       TextWrapping="Wrap" Foreground="#FF888888" Margin="10" VerticalAlignment="Center"
                                       Visibility="{Binding HasDocuments, Converter={StaticResource InverseBoolToVis}}"/>
                            <ListBox x:Name="DocumentsListBox" ItemsSource="{Binding Documents}" BorderThickness="0" MaxHeight="160"
                                     Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}"
                                     MouseDoubleClick="DocumentsList_MouseDoubleClick"
                                     PreviewKeyDown="DocumentsList_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="4,3" ToolTip="{Binding FullPath}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- Opens the Documents folder itself (not a specific entry) in Explorer -
                             the current version-family folder per DocumentsFolderLabel above. -->
                        <Button Content="Open Folder" Width="100" Padding="6,3"
                                Command="{Binding OpenDocumentsFolderCommand}"/>
                        <Button Content="Add File..." Width="120" Padding="6,3" Margin="8,0,0,0" Command="{Binding AddDocumentFilesCommand}"/>
                        <!-- Deletes whatever's selected in the list above (also removable via the
                             Delete key - see DocumentsList_PreviewKeyDown); BuildSectionViewModel.
                             DeleteDocument confirms first, since this is a permanent delete. -->
                        <Button Content="Delete" Width="90" Padding="6,3" Margin="8,0,0,0"
                                Command="{Binding DeleteDocumentCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DocumentsListBox}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress / status: runs in the background now, so this section (and every other tab,
             and the window itself) stays fully usable while it's visible. Cancel lets you back out
             without waiting it out. -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
            <DockPanel Margin="0,4,0,0">
                <Button Content="Cancel" DockPanel.Dock="Right" Width="70" Padding="4,2" Command="{Binding CancelUpdateCommand}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
    </Grid>
</UserControl>
