<UserControl x:Class="CommandCenter.View.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CommandCenter.View"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="620">
    <!-- The Launcher tab (LauncherViewModel): pick any build tab from the dropdown, then launch it,
         manage its debug command list / equipment picks, and its Documents - all without that
         build needing its own visible tab. Same layout idea as BuildSectionView: everything
         scrolls except the status strip pinned at the bottom. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,4">

                <!-- Build picker + at-a-glance build info -->
                <Border Background="#FFF3F3F3" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Big copy of the selected build's tab icon -->
                        <Image Grid.Column="0" Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                               Source="{Binding SelectedIconSource, Converter={StaticResource TabIconImage}}"/>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Build:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                      MinWidth="240" IsEnabled="{Binding HasSections}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconSource, Converter={StaticResource TabIconImage}}"
                                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                            <!-- Hidden tabs are still launchable from here - that's the point. -->
                                            <TextBlock Text=" (hidden)" Foreground="#FF888888" FontStyle="Italic" VerticalAlignment="Center"
                                                       Visibility="{Binding IsVisible, Converter={StaticResource InverseBoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal"
                                    Visibility="{Binding HasSections, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Current Build:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBuild.CurrentBuildPath, Mode=OneWay, TargetNullValue='Not set', FallbackValue='Not set'}"
                                       ToolTip="{Binding SelectedBuild.CurrentBuildPath, Mode=OneWay}"
                                       Margin="6,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                            <TextBlock Text="Version:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBuild.VersionNumber, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="No build tabs yet. Add one from the Settings tab (+ Add Tab)."
                           Foreground="#FF888888" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding HasSections, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- The selected build's own panels. DataContext inside is that tab's
                     BuildSectionViewModel, so these are the exact same controls/state the build
                     tab itself shows - nothing here is a copy. -->
                <ContentControl Content="{Binding SelectedBuild}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="Not configured. Set this build's path in the Settings tab first." Foreground="#FFB00000" Margin="0,0,0,8"
                                           Visibility="{Binding HasBuildPath, Converter={StaticResource InverseBoolToVis}}"/>

                                <local:LaunchPanelView/>

                                <local:DocumentsPanelView Margin="0,16,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Pinned status strip for the selected build: launch results, debug-list imports, and
             progress if something (e.g. Build Repo) is currently updating this build. -->
        <Border Grid.Row="1" BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0"/>
        <ContentControl Grid.Row="1" Content="{Binding SelectedBuild}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="16,8,16,12">
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button Content="Cancel" DockPanel.Dock="Right" Width="70" Padding="4,2" Command="{Binding CancelUpdateCommand}"/>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
