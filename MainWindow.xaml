                                <Style TargetType="Button">
                                    <!-- Hidden by default -->
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!-- Show if the RadioButton is checked -->
                                        <DataTrigger Binding="{Binding ElementName=BuildRadioButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Text="{Binding DisplayNewBuildPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="-153,35,0,0" VerticalAlignment="Top" TextWrapping="Wrap" MinWidth="120" Width="Auto" 
