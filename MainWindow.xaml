<Window x:Class="CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommandCenter"
        xmlns:ViewModel="clr-namespace:CommandCenter.ViewModel"
        mc:Ignorable="d"
        Title="Maple Builder" Height="220" Width="462" ResizeMode="NoResize">

    <Window.DataContext>
        <ViewModel:BuildSelection/>
    </Window.DataContext>

    <Grid>
        <TabControl Margin="0,0,0,-36">
