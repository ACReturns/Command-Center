                                    <DataTrigger Binding="{Binding ElementName=PatchRadioButton, Path=IsChecked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <RadioButton x:Name="BuildRadioButton" Content="New Build" Margin="13,86,0,0" IsChecked="True"/>
                        <RadioButton x:Name="PatchRadioButton" Content="Patch" Margin="13,86,0,0"/>
                        <RadioButton x:Name="LaunchRadioButton" Content="Launch" Margin="13,86,0,0"/>
                    

                        <!-- Update Build Option -->
                        <Button Content="Update" HorizontalAlignment="Left" Margin="-206, 34,0,0" VerticalAlignment="Top" Command="{Binding SelectUpdateCommand}">
