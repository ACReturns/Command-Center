                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Launch Build" HorizontalAlignment="Left" Margin="-130, 60,0,0" VerticalAlignment="Top" Command="{Binding LaunchBuild}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <!-- Hidden by default -->
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!-- Show if the RadioButton is checked -->
                                        <DataTrigger Binding="{Binding ElementName=LaunchLiveRadioButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedIndex="3"
                                  HorizontalAlignment="Left" Margin="-130,30,0,0" VerticalAlignment="Top" Width="Auto" Grid.ColumnSpan="2" RenderTransformOrigin="-0.562,0.489" >
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <!-- Hidden by default -->
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!-- Show if the RadioButton is checked -->
                                        <DataTrigger Binding="{Binding ElementName=LaunchLiveRadioButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3 Settings -->
            <TabItem Header="Settings">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
