<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>img\AppIcon.ico</ApplicationIcon>
    <AssemblyName>MapleCentral</AssemblyName>
    <AssemblyTitle>Maple Central</AssemblyTitle>
    <Product>Maple Central</Product>

    <!-- Version stamp shown in Settings > Updates as "ADW-MC-## · yyyy.MM.dd".
         Bump MapleCentralBuildNumber for every release you upload to Confluence; the date part
         is filled in automatically at build time. The updater compares this BuildDate (read out
         of the .7z's MapleCentral.dll) against the running one. -->
    <MapleCentralBuildNumber>07</MapleCentralBuildNumber>
    <MapleCentralBuildDate>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</MapleCentralBuildDate>
    <Version>$([System.DateTime]::Now.ToString('yyyy.M.d'))</Version>
    <InformationalVersion>ADW-MC-$(MapleCentralBuildNumber) ($([System.DateTime]::Now.ToString('yyyy.MM.dd')))</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildCode" Value="ADW-MC-$(MapleCentralBuildNumber)" />
    <AssemblyMetadata Include="BuildDate" Value="$(MapleCentralBuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="SharpCompress" Version="0.37.2" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Servers\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Server Up.gif / Server Down.gif (Server Status legend + per-world up/down icons) -
         relocated here from the Servers folder 2026-09-22. Copied as loose files into the output
         folder's own img\ subfolder, same "PreserveNewest" pattern as Servers\** above, rather
         than embedded like img\*.ico - WpfAnimatedGif's AnimatedSource couldn't reliably load
         these from an embedded pack-resource stream (that was tried first). AppPaths.ServerUpGif/
         ServerDownGif point at this copied-out file with a real filesystem path. -->
    <None Include="img\*.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
